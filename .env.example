# Local demonstration only. The server rejects NODE_ENV=production.
PORT=4318
# Set to the Python executable with reportlab installed.
HB_PYTHON=python
# Optional SQLite path; default: data/prototype.sqlite
# HB_DATABASE=data/prototype.sqlite
# Optional: URL of the authorized Hong Kong Python execution service (M1b).
# When unset, real-insurer products stay unavailable and never fall back to mock.
# HB_PYTHON_ADAPTER_URL=
# Credentials are referenced by credentialRef only; never put plaintext portal
# passwords, cookies, or API keys here or anywhere in the repo.
# Reserved for M2b. M2a-2 never connects to Dify: leave ALL of these unset.
# The app refuses to start when ANY variable below (or DIFY_API_KEY) is set.
# Extraction/chat use the limited local engine and explicitly report that no
# model was called.
# Dify issues one API key per app; each capability uses only its own key, and a
# missing key makes only that capability report "not configured". A single
# shared DIFY_API_KEY is not supported. Keys are injected from the secret
# manager at runtime, never written here or anywhere in the repo.
# Full list of reserved names: DIFY_ENV_VARS in server/dify/dify-client.mjs.
# DIFY_API_URL=
# DIFY_CHAT_API_KEY=        (broker_assistant_chat)
# DIFY_EXTRACT_API_KEY=     (proposal_extract)
# DIFY_COMPLIANCE_API_KEY=  (compliance_guard)
